# Notion API Credentials (Optional for local testing; app runs on demo seed data if omitted)
NOTION_API_KEY=secret_your_notion_integration_token_here

# Notion Database IDs (32-character hexadecimal IDs from your Notion database URLs)
NOTION_INGREDIENTS_DB_ID=your_ingredients_database_id_here
NOTION_READY_MEALS_DB_ID=your_ready_meals_database_id_here
NOTION_MEAL_LOG_DB_ID=your_meal_log_database_id_here
NOTION_PROFILE_DB_ID=your_profile_database_id_here
NOTION_PROGRESS_LOG_DB_ID=your_progress_log_database_id_here

# Instance owner (controls which Owner-filtered data this deployment shows)
NEXT_PUBLIC_APP_OWNER=Esther